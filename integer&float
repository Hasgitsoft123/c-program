#include <stdio.h>

int main() {

    int number;
    float decimal_number;

    printf("Enter i/p's : ");
    if (scanf("%d %f", &number, &decimal_number) != 2) {
        printf("Invalid input\n");
        return 1;
    }

    printf("Number : %d\n", number);
    printf("Decimal Number : %.1f\n", decimal_number);
    return 0;
}
