#include <stdio.h>

int main() {

    int number;
    float decimal_number;

    printf("Enter i/p's : ");
    scanf("%d %f",&number , &decimal_number);

    printf("Number : %d", number);
    printf("\nDecimal Number : %.1f", decimal_number);
    return 0;
}

